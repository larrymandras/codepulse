{
  "name": "codepulse",
  "version": "0.1.0",
  "private": true,
  "description": "CodePulse — Ástríðr runtime telemetry backend (Convex)",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npx convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit && vitest run --project browser",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:authed": "playwright test --project=chromium-authed",
    "dev:noauth": "vite --port 5181 --strictPort --host 127.0.0.1",
    "test:e2e:noauth": "playwright test",
    "test:e2e:noauth:help": "echo 'dev:noauth / test:e2e:noauth: npm run-script defaults to cmd.exe on Windows, which cannot parse an inline VAR= assignment, so the empty assignment must be issued at the invocation instead: VITE_CLERK_PUBLISHABLE_KEY= npm run dev:noauth  (and)  PW_BASE_URL=http://localhost:5181 npm run test:e2e:noauth -- issued from GIT BASH, never PowerShell (PS 5.1 deletes an env var assigned an empty string, silently leaving the Clerk gate live). Start dev:noauth in its own terminal FIRST -- playwright.config.ts webServer is hardcoded to 5173 and will report itself healthy while these tests target 5181. dev:noauth pins --host 127.0.0.1, overriding vite.config.ts server.host:true, because that config-level wide bind would otherwise expose this AUTH-DISABLED server on the tailnet/LAN -- never drop that flag. These specs exercise navigation only, not the Clerk auth gate.'",
    "deploy": "npx convex deploy && npx vite build",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "check:dead-surface": "node scripts/check-dead-surface.mjs",
    "check:dead-surface:list": "node scripts/check-dead-surface.mjs --list",
    "check:dead-surface:update": "node scripts/check-dead-surface.mjs --update",
    "hooks:install": "cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@types/dagre": "^0.7.54",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "idb-keyval": "^6.2.4",
    "js-yaml": "^5.2.1",
    "livekit-client": "2.20.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.38.0",
    "onnxruntime-web": "^1.27.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.1.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.21",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "shadcn": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
  }
}
